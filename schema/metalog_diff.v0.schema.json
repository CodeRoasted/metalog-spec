{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://metalog-spec.org/schema/metalog_diff.v0.schema.json",
    "title": "MetaLogDiff v0",
    "description": "Pair-wise difference between two MetaLog documents (SPEC §13).",
    "type": "object",
    "additionalProperties": true,
    "required": ["diff_version", "current", "previous"],
    "properties": {
        "diff_version": {
            "type": "string",
            "pattern": "^0\\.[0-9]+\\.[0-9]+$"
        },
        "current": {
            "type": "object",
            "required": ["window"],
            "properties": {
                "window": {
                    "type": "object",
                    "required": ["start", "end"],
                    "properties": {
                        "start": { "type": "string", "format": "date-time" },
                        "end": { "type": "string", "format": "date-time" }
                    },
                    "additionalProperties": true
                },
                "document_id": { "type": "string" }
            },
            "additionalProperties": false
        },
        "previous": {
            "type": "object",
            "required": ["window"],
            "properties": {
                "window": {
                    "type": "object",
                    "required": ["start", "end"],
                    "properties": {
                        "start": { "type": "string", "format": "date-time" },
                        "end": { "type": "string", "format": "date-time" }
                    },
                    "additionalProperties": true
                },
                "document_id": { "type": "string" }
            },
            "additionalProperties": false
        },
        "kl_divergence": { "type": "number", "minimum": 0 },
        "js_divergence": { "type": "number", "minimum": 0, "maximum": 1 },
        "stability_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "template_deltas": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["template_id", "previous_count", "current_count", "delta"],
                "properties": {
                    "template_id": { "type": "string", "pattern": "^[a-z]+:.+$" },
                    "previous_count": { "type": "integer", "minimum": 0 },
                    "current_count": { "type": "integer", "minimum": 0 },
                    "delta": { "type": "integer" },
                    "previous_frequency": { "type": "number", "minimum": 0, "maximum": 1 },
                    "current_frequency": { "type": "number", "minimum": 0, "maximum": 1 }
                },
                "additionalProperties": false
            }
        },
        "field_histogram_deltas": {
            "type": "array",
            "description": "Per-slot value-distribution change between the two documents' param_histograms (SPEC §3.5.2). MUST be sorted by js_divergence descending — an ordering the schema cannot assert; §3.5.2 owns it. Added to the schema in v0.8.0 (normative in the prose since v0.3.0).",
            "items": {
                "type": "object",
                "required": ["template_id", "param_index"],
                "properties": {
                    "template_id": { "type": "string", "pattern": "^[a-z]+:.+$" },
                    "param_index": { "type": "integer", "minimum": 0 },
                    "js_divergence": { "type": "number", "minimum": 0, "maximum": 1 },
                    "previous_entropy_bits": { "type": "number", "minimum": 0 },
                    "current_entropy_bits": { "type": "number", "minimum": 0 },
                    "previous_sample_count": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Observations backing the previous distribution (that slot's param_histogram total). The sample size js_divergence is estimated from — a consumer's min-sample confidence floor. Distinct from cardinality (distinct values) and from the template's stream share. Added in v0.8.0."
                    },
                    "current_sample_count": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Observations backing the current distribution. See previous_sample_count. Added in v0.8.0."
                    },
                    "previous_cardinality": { "type": "integer", "minimum": 0 },
                    "current_cardinality": { "type": "integer", "minimum": 0 },
                    "cardinality_delta": {
                        "type": "integer",
                        "description": "MUST equal current_cardinality - previous_cardinality (SPEC §3.5.2)."
                    }
                },
                "additionalProperties": false
            }
        },
        "new_templates": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z]+:.+$" }
        },
        "vanished_templates": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z]+:.+$" }
        },
        "branching_delta": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["template_id", "previous_entropy_bits", "current_entropy_bits", "delta_bits"],
                "properties": {
                    "template_id": { "type": "string", "pattern": "^[a-z]+:.+$" },
                    "previous_entropy_bits": { "type": "number", "minimum": 0 },
                    "current_entropy_bits": { "type": "number", "minimum": 0 },
                    "delta_bits": { "type": "number" }
                },
                "additionalProperties": false
            }
        },
        "ngram_delta": {
            "type": "object",
            "required": ["ngram_size"],
            "properties": {
                "ngram_size": { "type": "integer", "minimum": 2 },
                "new_ngrams": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "minItems": 2,
                        "items": { "type": "string", "pattern": "^[a-z]+:.+$" }
                    }
                },
                "vanished_ngrams": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "minItems": 2,
                        "items": { "type": "string", "pattern": "^[a-z]+:.+$" }
                    }
                },
                "rate_changed": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["sequence", "previous_probability", "current_probability", "delta"],
                        "properties": {
                            "sequence": {
                                "type": "array",
                                "minItems": 2,
                                "items": { "type": "string", "pattern": "^[a-z]+:.+$" }
                            },
                            "previous_probability": { "type": "number", "minimum": 0, "maximum": 1 },
                            "current_probability": { "type": "number", "minimum": 0, "maximum": 1 },
                            "delta": { "type": "number" }
                        },
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        },
        "tail_delta": {
            "type": "object",
            "description": "Long-tail shape change (SPEC §13). Present only when both documents carried a stats.tail_summary.",
            "required": [
                "previous_tail_template_count", "current_tail_template_count", "tail_template_count_delta",
                "previous_tail_entropy_bits", "current_tail_entropy_bits", "tail_entropy_bits_delta",
                "previous_tail_max_rate", "current_tail_max_rate", "tail_max_rate_delta"
            ],
            "properties": {
                "previous_tail_template_count": { "type": "integer", "minimum": 0 },
                "current_tail_template_count": { "type": "integer", "minimum": 0 },
                "tail_template_count_delta": { "type": "integer" },
                "previous_tail_entropy_bits": { "type": "number", "minimum": 0 },
                "current_tail_entropy_bits": { "type": "number", "minimum": 0 },
                "tail_entropy_bits_delta": { "type": "number" },
                "previous_tail_max_rate": { "type": "number", "minimum": 0, "maximum": 1 },
                "current_tail_max_rate": { "type": "number", "minimum": 0, "maximum": 1 },
                "tail_max_rate_delta": { "type": "number" }
            },
            "additionalProperties": false
        },
        "cube_diff": {
            "type": "object",
            "description": "Emerging-border diff of two cube blocks (SPEC §13.6, §16). Present only when both inputs carried a cube and their axes are equal. Experimental, added in v0.6.0.",
            "required": ["axes"],
            "properties": {
                "axes": {
                    "type": "array",
                    "minItems": 1,
                    "description": "MUST equal both inputs' cube.axes.",
                    "items": { "$ref": "#/$defs/cube_axis" }
                },
                "emerging": {
                    "description": "Growth region (count_prev <= theta_was AND count_cur >= theta_now): order-convex, a (lower, upper) border pair.",
                    "$ref": "#/$defs/cube_border"
                },
                "vanishing": {
                    "description": "Disappearance region (the dual): count_prev >= theta_was AND count_cur <= theta_now.",
                    "$ref": "#/$defs/cube_border"
                }
            },
            "additionalProperties": false
        },
        "reservoir_delta": {
            "type": "object",
            "description": "Rare-salient membership change between the two documents' stats.reservoir blocks (SPEC §13.7). Membership is decided over top_k UNION reservoir on each side, never over reservoir alone: a template that moved between the two retention mechanisms has not appeared or disappeared. Omitted entirely when all three lists are empty; every list MUST be sorted by template_id ascending — an ordering the schema cannot assert. Added in v0.9.0.",
            "properties": {
                "new_salient": {
                    "type": "array",
                    "description": "Entries in current.stats.reservoir whose template_id is in neither of previous's two blocks. count and salience are current's (SPEC §13.7.1).",
                    "items": { "$ref": "#/$defs/reservoir_delta_entry" }
                },
                "vanished_salient": {
                    "type": "array",
                    "description": "Entries in previous.stats.reservoir whose template_id is in neither of current's two blocks. count and salience are previous's (SPEC §13.7.1).",
                    "items": { "$ref": "#/$defs/reservoir_delta_entry" }
                },
                "frontier_crossings": {
                    "type": "array",
                    "description": "Templates present on BOTH sides whose level crossed the {ERROR, FATAL} failure frontier (SPEC §13.7.2). Frontier membership is a SET test, never an ordinal compare against ERROR.",
                    "items": {
                        "type": "object",
                        "required": ["template_id", "direction"],
                        "properties": {
                            "template_id": { "type": "string", "pattern": "^[a-z]+:.+$" },
                            "direction": {
                                "type": "string",
                                "enum": ["up", "down"],
                                "description": "Oriented previous -> current: up = crossed INTO the frontier, down = crossed OUT. Signed and polarity-mute — whether that is an escalation or a recovery is the consumer's reading, not this document's claim."
                            },
                            "previous_level": { "type": "string" },
                            "current_level": { "type": "string" }
                        },
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        },
        "extensions": {
            "description": "Document-level vendor-specific data on a MetaLogDiff (SPEC §7). This placement was granted in v0.9.0. The root itself is open (additionalProperties: true), so a bare vendor member written beside this container validates while violating §7: the container is where such data belongs, and at an open root the schema does not tell the two apart.",
            "$ref": "#/$defs/extensions"
        }
    },
    "$defs": {
        "reservoir_delta_entry": {
            "type": "object",
            "description": "One rare-salient membership change (SPEC §13.7.1). A SUBSET of the §3.7.1 reservoir entry, and every field means there what it means here. count and salience MUST be copied from the document the entry comes from, never re-derived at diff time; salience is comparable across the pair only because §2.4's gate already requires a matching retention_profile.",
            "required": ["template_id", "count", "salience"],
            "properties": {
                "template_id": { "type": "string", "pattern": "^[a-z]+:.+$" },
                "count": { "type": "integer", "minimum": 0 },
                "salience": { "type": "integer", "minimum": 0 },
                "level": { "type": "string" },
                "structural_role": { "type": "string" }
            },
            "additionalProperties": false
        },
        "extensions": {
            "type": "object",
            "description": "The §7 extension container: reverse-DNS keys, arbitrary payloads, closed to everything else. Mirrors metalog.v0.schema.json #/$defs/extensions — DUPLICATED rather than cross-referenced, because each schema file is independently consumable and a cross-file $ref cannot be resolved offline. conformance/metalog_validate.py --selftest asserts that every $defs name the two files share is identical, so the duplicate cannot drift. Closure is preserved: a misspelled STANDARD member is still rejected by its object, because it is not inside this container.",
            "patternProperties": {
                "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$": {}
            },
            "additionalProperties": false
        },
        "cube_axis": {
            "type": "object",
            "description": "A cube axis descriptor (SPEC §16.2). Mirrors metalog.v0.schema.json #/$defs/cube_axis.",
            "required": ["name", "kind"],
            "properties": {
                "name": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "enum": ["categorical", "chain"] },
                "chain": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                },
                "floor_depth": { "type": "integer", "minimum": 1 },
                "band_floor": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Ordinal-axis collapse stamp (SPEC §16.2/§16.10): the applied interval-banding floor, omitted when no banding was applied. It is carried here because §13.6 requires cube_diff.axes to EQUAL both inputs' cube.axes, so a diff of two collapsed cubes carries the stamp its inputs carry. Added to metalog.v0.schema.json in v0.8.0 and to this mirror in v0.9.0."
                }
            },
            "additionalProperties": false,
            "if": { "properties": { "kind": { "const": "chain" } } },
            "then": { "required": ["chain", "floor_depth"] }
        },
        "cube_coord": {
            "type": "object",
            "description": "A cube cell coordinate, generic over axes (SPEC §16.4). Each key is a cube axis NAME; an absent axis means aggregated (*). Categorical value = string; chain value = ordered prefix-path array. Mirrors metalog.v0.schema.json #/$defs/cube_coord.",
            "additionalProperties": {
                "oneOf": [
                    { "type": "string", "minLength": 1 },
                    { "type": "array", "items": { "type": "string", "minLength": 1 } }
                ]
            }
        },
        "cube_border": {
            "type": "object",
            "description": "An order-convex emerging/vanishing region as a (lower, upper) border pair (SPEC §13.6). lower = most-specific cells (the precise description); upper = most-general cells (the minimal generators = the deterministic headline).",
            "required": ["lower", "upper"],
            "properties": {
                "lower": { "type": "array", "items": { "$ref": "#/$defs/cube_border_cell" } },
                "upper": { "type": "array", "items": { "$ref": "#/$defs/cube_border_cell" } }
            },
            "additionalProperties": false
        },
        "cube_border_cell": {
            "type": "object",
            "required": ["coord", "previous_count", "current_count"],
            "properties": {
                "coord": { "$ref": "#/$defs/cube_coord" },
                "previous_count": { "type": "integer", "minimum": 0 },
                "current_count": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
        }
    }
}
