{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://metalog-spec.org/schema/metalog.v0.schema.json",
    "title": "MetaLog v0",
    "description": "A bounded-size statistical fingerprint of a window of log behaviour. Tracks the MetaLog v0.x line; pin a concrete version via the document's metalog_version, not this schema URI (SPEC §9). See https://github.com/CodeRoasted/metalog-spec/blob/main/SPEC.md",
    "type": "object",
    "additionalProperties": true,
    "required": [
        "metalog_version",
        "producer",
        "window",
        "source",
        "stats"
    ],
    "properties": {
        "metalog_version": {
            "type": "string",
            "pattern": "^0\\.[0-9]+\\.[0-9]+$",
            "description": "SemVer string, MAJOR=0 for this schema."
        },
        "producer": {
            "type": "object",
            "required": [
                "name",
                "version"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "implementation_uri": {
                    "type": "string",
                    "format": "uri"
                }
            },
            "additionalProperties": false
        },
        "window": {
            "type": "object",
            "required": [
                "start",
                "end",
                "duration_seconds",
                "lines_observed"
            ],
            "properties": {
                "start": {
                    "type": "string",
                    "format": "date-time"
                },
                "end": {
                    "type": "string",
                    "format": "date-time"
                },
                "duration_seconds": {
                    "type": "integer",
                    "minimum": 0
                },
                "lines_observed": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "source": {
            "type": "object",
            "properties": {
                "service": {
                    "type": "string"
                },
                "fleet": {
                    "type": "string"
                },
                "host_count": {
                    "type": "integer",
                    "minimum": 0
                },
                "host": {
                    "type": "string"
                },
                "tags": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "templates": {
            "type": "object",
            "description": "Optional dedup map template_id -> template_str (SPEC §3.4).",
            "patternProperties": {
                "^[a-z]+:.+$": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        },
        "stats": {
            "type": "object",
            "required": [
                "unique_templates",
                "top_k",
                "top_k_size",
                "tail_count",
                "tail_unique"
            ],
            "properties": {
                "unique_templates": {
                    "type": "integer",
                    "minimum": 0
                },
                "top_k_size": {
                    "type": "integer",
                    "minimum": 1
                },
                "tail_count": {
                    "type": "integer",
                    "minimum": 0
                },
                "tail_unique": {
                    "type": "integer",
                    "minimum": 0
                },
                "entropy_bits": {
                    "type": "number",
                    "minimum": 0
                },
                "tail_summary": {
                    "type": "object",
                    "description": "Optional bounded summary of the tail (templates not in top_k). Added in v0.4.0. See SPEC §3.6.",
                    "required": [
                        "tail_template_count",
                        "tail_entropy_bits",
                        "tail_max_rate"
                    ],
                    "properties": {
                        "tail_template_count": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "tail_entropy_bits": {
                            "type": "number",
                            "minimum": 0
                        },
                        "tail_max_rate": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        }
                    },
                    "additionalProperties": false
                },
                "top_k": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "template_id",
                            "count",
                            "frequency"
                        ],
                        "properties": {
                            "template_id": {
                                "type": "string",
                                "pattern": "^[a-z]+:.+$"
                            },
                            "template": {
                                "type": "string",
                                "minLength": 1
                            },
                            "count": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "frequency": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                            },
                            "level": {
                                "type": "string"
                            },
                            "param_histograms": {
                                "type": "array",
                                "description": "Per-wildcard-position value-count histograms for this template (SPEC §3.5). Optional, batch-mode emission (see §3.5). MUST NOT be present for entries not in top_k.",
                                "items": {
                                    "$ref": "#/$defs/param_histogram"
                                }
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "reservoir": {
                    "type": "array",
                    "description": "Salient entries retained beyond top_k by intrinsic salience, not frequency (SPEC §3.7). Added in v0.5.0. A reservoir entry MUST NOT also appear in top_k.",
                    "items": {
                        "$ref": "#/$defs/reservoir_entry"
                    }
                }
            },
            "additionalProperties": false
        },
        "behavior": {
            "type": "object",
            "required": [
                "ngram_size",
                "top_ngrams",
                "top_ngrams_size"
            ],
            "properties": {
                "ngram_size": {
                    "type": "integer",
                    "minimum": 2
                },
                "top_ngrams_size": {
                    "type": "integer",
                    "minimum": 1
                },
                "graph_edge_count": {
                    "type": "integer",
                    "minimum": 0
                },
                "dominant_path": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z]+:.+$"
                    }
                },
                "branching": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "template_id",
                            "fanout",
                            "total_outgoing",
                            "entropy_bits"
                        ],
                        "properties": {
                            "template_id": {
                                "type": "string",
                                "pattern": "^[a-z]+:.+$"
                            },
                            "fanout": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "total_outgoing": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "entropy_bits": {
                                "type": "number",
                                "minimum": 0
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "top_ngrams": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "sequence",
                            "count",
                            "probability"
                        ],
                        "properties": {
                            "sequence": {
                                "type": "array",
                                "minItems": 2,
                                "items": {
                                    "type": "string",
                                    "pattern": "^[a-z]+:.+$"
                                }
                            },
                            "count": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "probability": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                            }
                        },
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        },
        "stability": {
            "type": "object",
            "required": [
                "previous_window_end"
            ],
            "properties": {
                "previous_window_end": {
                    "type": "string",
                    "format": "date-time"
                },
                "kl_divergence": {
                    "type": "number",
                    "minimum": 0
                },
                "js_divergence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "new_templates": {
                    "type": "integer",
                    "minimum": 0
                },
                "vanished_templates": {
                    "type": "integer",
                    "minimum": 0
                },
                "stability_score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "additionalProperties": false
        },
        "attribution": {
            "type": "object",
            "required": [
                "dimension",
                "sketch_type",
                "sketch_params",
                "encoded"
            ],
            "properties": {
                "dimension": {
                    "type": "string",
                    "minLength": 1
                },
                "sketch_type": {
                    "type": "string",
                    "enum": [
                        "count_min",
                        "exact",
                        "topk_per_dim"
                    ]
                },
                "sketch_params": {
                    "type": "object"
                },
                "encoded": {
                    "type": "string",
                    "pattern": "^base64:"
                }
            },
            "additionalProperties": false
        },
        "provenance": {
            "type": "array",
            "description": "Set when this MetaLog was composed from others (SPEC §12).",
            "items": {
                "type": "object",
                "required": [
                    "window"
                ],
                "properties": {
                    "window": {
                        "type": "object",
                        "required": [
                            "start",
                            "end"
                        ],
                        "properties": {
                            "start": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "end": {
                                "type": "string",
                                "format": "date-time"
                            }
                        },
                        "additionalProperties": true
                    },
                    "source": {
                        "type": "object"
                    },
                    "lines_observed": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "document_id": {
                        "type": "string"
                    },
                    "coordinate": {
                        "description": "The raw child's re-derivation coordinate (SPEC §15.5). Added in v0.5.0.",
                        "$ref": "#/$defs/coordinate"
                    }
                },
                "additionalProperties": false
            }
        },
        "canonicalization_version": {
            "type": "string",
            "description": "Opaque identifier for the canonicalization rules in effect; gates compose()/diff comparability (SPEC §2.4). Added in v0.5.0."
        },
        "retention_profile": {
            "type": "string",
            "description": "Opaque identifier for the retention parameters — top_k size, reservoir admission weights/size/diversity caps, and the salience arithmetic; gates compose()/diff comparability (SPEC §2.4). Added in v0.5.0."
        },
        "coordinate": {
            "description": "Re-derivation coordinate addressing this window back to its source: raw(window) = replay(source, bounds) (SPEC §15). A raw coordinate XOR a composed coordinate. Added in v0.5.0.",
            "$ref": "#/$defs/coordinate"
        },
        "extensions": {
            "type": "object",
            "patternProperties": {
                "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$": {}
            },
            "additionalProperties": false
        }
    },
    "$defs": {
        "coordinate": {
            "type": "object",
            "description": "Re-derivation coordinate (SPEC §15.2). Exactly one of {source_ref + bounds} (raw) or {children} (composed) MUST be present — never both, never neither; consumers discriminate by the presence of children.",
            "properties": {
                "source_ref": {
                    "$ref": "#/$defs/source_ref"
                },
                "bounds": {
                    "$ref": "#/$defs/bounds"
                },
                "canonicalization_version": {
                    "type": "string",
                    "description": "Semantic canonicalization-rules version; required for fingerprint reproduction (guarantee 2). Not a binary build id."
                },
                "config_hash": {
                    "type": "string",
                    "description": "Hash of the effective canon+metalog config; for fingerprint reproduction (guarantee 2)."
                },
                "children": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Composed coordinate: the non-empty set of raw children's coordinates (SPEC §15.5). MUST NOT co-occur with source_ref/bounds.",
                    "items": {
                        "$ref": "#/$defs/coordinate"
                    }
                }
            },
            "additionalProperties": false,
            "oneOf": [
                {
                    "title": "raw coordinate",
                    "required": [
                        "source_ref",
                        "bounds"
                    ],
                    "not": {
                        "required": [
                            "children"
                        ]
                    }
                },
                {
                    "title": "composed coordinate",
                    "required": [
                        "children"
                    ],
                    "allOf": [
                        {
                            "not": {
                                "required": [
                                    "source_ref"
                                ]
                            }
                        },
                        {
                            "not": {
                                "required": [
                                    "bounds"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        "source_ref": {
            "type": "object",
            "description": "Opaque resolvable handle + a tag selecting the resolver (SPEC §15.2). resolver_kind is environment-defined (e.g. logcraft, an artifact-URI kind, otel_trace); a producer MUST NOT assume a particular resolver.",
            "required": [
                "resolver_kind",
                "handle"
            ],
            "properties": {
                "resolver_kind": {
                    "type": "string",
                    "minLength": 1
                },
                "handle": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "bounds": {
            "type": "object",
            "description": "Event-time integer ticks; the window is [start_tick, end_tick) (SPEC §15.2/§15.3). Integers only — no float — and bit-identical across replays.",
            "required": [
                "start_tick",
                "end_tick"
            ],
            "properties": {
                "start_tick": {
                    "type": "integer",
                    "minimum": 0
                },
                "end_tick": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "reservoir_entry": {
            "type": "object",
            "description": "A salience-admitted entry (SPEC §3.7.1). Self-describing: carries the per-axis bands and the composite salience so a consumer can attribute it without the producer.",
            "required": [
                "template_id",
                "count",
                "frequency",
                "structural_surprise",
                "novelty",
                "salience"
            ],
            "properties": {
                "template_id": {
                    "type": "string",
                    "pattern": "^[a-z]+:.+$"
                },
                "count": {
                    "type": "integer",
                    "minimum": 0
                },
                "frequency": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "template": {
                    "type": "string",
                    "minLength": 1
                },
                "level": {
                    "type": "string"
                },
                "structural_role": {
                    "type": "string"
                },
                "structural_surprise": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                },
                "novelty": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                },
                "salience": {
                    "type": "integer",
                    "minimum": 0
                },
                "within_window_ordinal": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "param_histogram": {
            "type": "object",
            "description": "A per-wildcard-position value-count histogram (SPEC §3.5). value_counts is bounded (top-N values); total MAY exceed sum(value_counts) when the cap is hit. value_counts MUST serialise key-sorted for replay bit-identity (SPEC §15.6).",
            "required": [
                "param_index",
                "value_counts",
                "total"
            ],
            "properties": {
                "param_index": {
                    "type": "integer",
                    "minimum": 0
                },
                "value_counts": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "total": {
                    "type": "integer",
                    "minimum": 0
                },
                "entropy_bits": {
                    "type": "number",
                    "minimum": 0
                },
                "approximate_cardinality": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        }
    }
}