{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://metalog-spec.org/schema/metalog.v0.schema.json",
    "title": "MetaLog v0",
    "description": "A bounded-size statistical fingerprint of a window of log behaviour. Tracks the MetaLog v0.x line; pin a concrete version via the document's metalog_version, not this schema URI (SPEC §9). See https://github.com/CodeRoasted/metalog-spec/blob/main/SPEC.md",
    "type": "object",
    "additionalProperties": {
        "description": "Open, and NOT by design: this root admits any member, including a bare vendor member §7 forbids, so an unknown key here validates and is reported legal-but-undescribed rather than rejected. Closing it is a breaking change under GOVERNANCE.md §2 and is not in this release."
    },
    "required": [
        "metalog_version",
        "producer",
        "window",
        "source",
        "stats"
    ],
    "properties": {
        "metalog_version": {
            "type": "string",
            "pattern": "^0\\.[0-9]+\\.[0-9]+$",
            "description": "SemVer string, MAJOR=0 for this schema."
        },
        "producer": {
            "type": "object",
            "required": [
                "name",
                "version"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "implementation_uri": {
                    "type": "string",
                    "format": "uri"
                }
            },
            "additionalProperties": false
        },
        "window": {
            "type": "object",
            "required": [
                "start",
                "end",
                "duration_seconds",
                "lines_observed"
            ],
            "properties": {
                "start": {
                    "type": "string",
                    "format": "date-time"
                },
                "end": {
                    "type": "string",
                    "format": "date-time"
                },
                "duration_seconds": {
                    "type": "integer",
                    "minimum": 0
                },
                "lines_observed": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "source": {
            "type": "object",
            "properties": {
                "service": {
                    "type": "string"
                },
                "fleet": {
                    "type": "string"
                },
                "host_count": {
                    "type": "integer",
                    "minimum": 0
                },
                "host": {
                    "type": "string"
                },
                "tags": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "templates": {
            "type": "object",
            "description": "Optional dedup map template_id -> template_str (SPEC §3.4).",
            "patternProperties": {
                "^[a-z]+:.+$": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        },
        "stats": {
            "type": "object",
            "required": [
                "unique_templates",
                "top_k",
                "top_k_size",
                "tail_count",
                "tail_unique"
            ],
            "properties": {
                "unique_templates": {
                    "type": "integer",
                    "minimum": 0
                },
                "top_k_size": {
                    "type": "integer",
                    "minimum": 1
                },
                "reservoir_size": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "The producer's cap on the reservoir array (SPEC \u00a73.7). Optional; declaring it is what makes the block's envelope contribution computable (SPEC \u00a711.1) and its bound checkable (SPEC \u00a78 clause 4). Added in v0.9.0."
                },
                "tail_count": {
                    "type": "integer",
                    "minimum": 0
                },
                "tail_unique": {
                    "type": "integer",
                    "minimum": 0
                },
                "entropy_bits": {
                    "type": "number",
                    "minimum": 0
                },
                "tail_summary": {
                    "type": "object",
                    "description": "Optional bounded summary of the tail (templates not in top_k). Added in v0.4.0. See SPEC §3.6.",
                    "required": [
                        "tail_template_count",
                        "tail_entropy_bits",
                        "tail_max_rate"
                    ],
                    "properties": {
                        "tail_template_count": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "tail_entropy_bits": {
                            "type": "number",
                            "minimum": 0
                        },
                        "tail_max_rate": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        }
                    },
                    "additionalProperties": false
                },
                "top_k": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "template_id",
                            "count",
                            "frequency"
                        ],
                        "properties": {
                            "template_id": {
                                "type": "string",
                                "pattern": "^[a-z]+:.+$"
                            },
                            "template": {
                                "type": "string",
                                "minLength": 1
                            },
                            "count": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "frequency": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                            },
                            "level": {
                                "type": "string"
                            },
                            "component": {
                                "type": "string",
                                "minLength": 1,
                                "description": "The functional source (logger / module / unit / subsystem) that dominates this template's occurrences in the window (SPEC §3.8). Same species as `level`: a categorical label the window carries, not a producer-internal state. OMITTED when the format carried no component — never the empty string, which would be an absent location masquerading as a present one. Added in v0.8.0."
                            },
                            "extensions": {
                                "description": "Per-row vendor-specific data (SPEC §7). Same grammar as the top-level `extensions`; placement is per-row because the datum is per-row. Added in v0.8.0.",
                                "$ref": "#/$defs/extensions"
                            },
                            "param_histograms": {
                                "type": "array",
                                "description": "Per-wildcard-position value-count histograms for this template (SPEC §3.5). Optional, batch-mode emission (see §3.5). MUST NOT be present for entries not in top_k.",
                                "items": {
                                    "$ref": "#/$defs/param_histogram"
                                }
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "reservoir": {
                    "type": "array",
                    "description": "Salient entries retained beyond top_k by intrinsic salience, not frequency (SPEC §3.7). Added in v0.5.0. A reservoir entry MUST NOT also appear in top_k.",
                    "items": {
                        "$ref": "#/$defs/reservoir_entry"
                    }
                }
            },
            "additionalProperties": false
        },
        "behavior": {
            "type": "object",
            "required": [
                "ngram_size",
                "top_ngrams",
                "top_ngrams_size"
            ],
            "properties": {
                "ngram_size": {
                    "type": "integer",
                    "minimum": 2
                },
                "top_ngrams_size": {
                    "type": "integer",
                    "minimum": 1
                },
                "branching_size": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "The producer's cap on the branching array (SPEC \u00a74.2). OMITTED means the producer declares no cap \u2014 a legal but unbounded posture, not a default. Added in v0.9.0."
                },
                "dropped_ngram_observations": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "n-gram OBSERVATIONS (never distinct keys) refused by a producer's accounting bound before being counted — distinct from top_ngrams ranking truncation. OMITTED when zero; in a 0.7.0+ document absence means no drop, in an earlier one it means unknown (SPEC \u00a76)."
                },
                "graph_edge_count": {
                    "type": "integer",
                    "minimum": 0
                },
                "dominant_path": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z]+:.+$"
                    }
                },
                "branching": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "template_id",
                            "fanout",
                            "total_outgoing",
                            "entropy_bits"
                        ],
                        "properties": {
                            "template_id": {
                                "type": "string",
                                "pattern": "^[a-z]+:.+$"
                            },
                            "fanout": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "total_outgoing": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "entropy_bits": {
                                "type": "number",
                                "minimum": 0
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "top_ngrams": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "sequence",
                            "count",
                            "probability"
                        ],
                        "properties": {
                            "sequence": {
                                "type": "array",
                                "minItems": 2,
                                "items": {
                                    "type": "string",
                                    "pattern": "^[a-z]+:.+$"
                                }
                            },
                            "count": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "probability": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                            }
                        },
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        },
        "stability": {
            "type": "object",
            "required": [
                "previous_window_end"
            ],
            "properties": {
                "previous_window_end": {
                    "type": "string",
                    "format": "date-time"
                },
                "kl_divergence": {
                    "type": "number",
                    "minimum": 0
                },
                "js_divergence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "new_templates": {
                    "type": "integer",
                    "minimum": 0
                },
                "vanished_templates": {
                    "type": "integer",
                    "minimum": 0
                },
                "stability_score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "additionalProperties": false
        },
        "attribution": {
            "type": "object",
            "required": [
                "dimension",
                "sketch_type",
                "sketch_params",
                "encoded"
            ],
            "properties": {
                "dimension": {
                    "type": "string",
                    "minLength": 1
                },
                "sketch_type": {
                    "type": "string",
                    "enum": [
                        "count_min",
                        "exact",
                        "topk_per_dim"
                    ]
                },
                "sketch_params": {
                    "type": "object",
                    "additionalProperties": {
                        "description": "A MAP, not a leak: §6 makes the parameter set depend on `sketch_type`, so the keys (`width`, `depth`, `hash_seed`, …) are DATA this vendor-neutral standard does not enumerate. `additionalProperties: false` here would admit ONLY the empty object, and §6 makes the field required — every document carrying `attribution` would become invalid."
                    }
                },
                "encoded": {
                    "type": "string",
                    "pattern": "^base64:"
                }
            },
            "additionalProperties": false
        },
        "cube": {
            "description": "Intra-window joint categorical condensation (closed cube). Experimental, additive, removable in a single revert (SPEC §16). Added in v0.6.0.",
            "$ref": "#/$defs/cube"
        },
        "provenance": {
            "type": "array",
            "description": "Set when this MetaLog was composed from others (SPEC §12).",
            "items": {
                "type": "object",
                "required": [
                    "window"
                ],
                "properties": {
                    "window": {
                        "type": "object",
                        "required": [
                            "start",
                            "end"
                        ],
                        "properties": {
                            "start": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "end": {
                                "type": "string",
                                "format": "date-time"
                            }
                        },
                        "additionalProperties": {
                            "description": "Open, and NOT by design: this window object names `start` and `end` and admits anything else, while the document-level `window` (§2.2) is closed. Closing it is a breaking change under GOVERNANCE.md §2 and is not in this release."
                        }
                    },
                    "source": {
                        "type": "object",
                        "additionalProperties": {
                            "description": "Open, and NOT by design: §12.4's own example carries `service` and `host` here and this position declares neither, so closing it bare would forbid the members the spec itself shows. It is a standard OBJECT, not a map — what it needs is its members declared, which is a breaking change under GOVERNANCE.md §2 and is not in this release."
                        }
                    },
                    "lines_observed": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "document_id": {
                        "type": "string"
                    },
                    "coordinate": {
                        "description": "The raw child's re-derivation coordinate (SPEC §15.5). Added in v0.5.0.",
                        "$ref": "#/$defs/coordinate"
                    }
                },
                "additionalProperties": false
            }
        },
        "canonicalization_version": {
            "type": "string",
            "description": "Opaque identifier for the canonicalization rules in effect; gates compose()/diff comparability (SPEC §2.4). Added in v0.5.0."
        },
        "retention_profile": {
            "type": "string",
            "description": "Opaque identifier for the retention parameters — top_k size, reservoir admission weights/size/diversity caps, and the salience arithmetic; gates compose()/diff comparability (SPEC §2.4). Added in v0.5.0."
        },
        "coordinate": {
            "description": "Re-derivation coordinate addressing this window back to its source: raw(window) = replay(source, bounds) (SPEC §15). A raw coordinate XOR a composed coordinate. Added in v0.5.0.",
            "$ref": "#/$defs/coordinate"
        },
        "run_outcome": {
            "type": "string",
            "enum": ["success", "failure", "unstable", "aborted"],
            "description": "Terminal verdict of the run this window covers (SPEC §2.5). MUST be derived from the OBSERVED events, never from producer state or an out-of-band control plane. OMITTED when no verdict was observed — there is no wire value for unknown, and a consumer MUST NOT read absence as success. The enum is closed: a verdict outside it is vendor data and belongs in extensions (§7). Added in v0.9.0."
        },
        "extensions": {
            "description": "Document-level vendor-specific data (SPEC §7).",
            "$ref": "#/$defs/extensions"
        }
    },
    "$defs": {
        "extensions": {
            "type": "object",
            "description": "The §7 extension container: reverse-DNS keys, arbitrary payloads, closed to everything else. Defined once and referenced at every object the spec grants one, so the grammar cannot drift between placements. Closure is preserved: a misspelled STANDARD member is still rejected by its object, because it is not inside this container.",
            "patternProperties": {
                "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$": {}
            },
            "additionalProperties": false
        },
        "coordinate": {
            "type": "object",
            "description": "Re-derivation coordinate (SPEC §15.2). Exactly one of {source_ref + bounds} (raw) or {children} (composed) MUST be present — never both, never neither; consumers discriminate by the presence of children.",
            "properties": {
                "source_ref": {
                    "$ref": "#/$defs/source_ref"
                },
                "bounds": {
                    "$ref": "#/$defs/bounds"
                },
                "canonicalization_version": {
                    "type": "string",
                    "description": "Semantic canonicalization-rules version; required for fingerprint reproduction (guarantee 2). Not a binary build id."
                },
                "config_hash": {
                    "type": "string",
                    "description": "Hash of the effective canon+metalog config; for fingerprint reproduction (guarantee 2)."
                },
                "children": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Composed coordinate: the non-empty set of raw children's coordinates (SPEC §15.5). MUST NOT co-occur with source_ref/bounds.",
                    "items": {
                        "$ref": "#/$defs/coordinate"
                    }
                }
            },
            "additionalProperties": false,
            "oneOf": [
                {
                    "title": "raw coordinate",
                    "required": [
                        "source_ref",
                        "bounds"
                    ],
                    "not": {
                        "required": [
                            "children"
                        ]
                    }
                },
                {
                    "title": "composed coordinate",
                    "required": [
                        "children"
                    ],
                    "allOf": [
                        {
                            "not": {
                                "required": [
                                    "source_ref"
                                ]
                            }
                        },
                        {
                            "not": {
                                "required": [
                                    "bounds"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        "source_ref": {
            "type": "object",
            "description": "Opaque resolvable handle + a tag selecting the resolver (SPEC §15.2). resolver_kind is environment-defined (e.g. logcraft, an artifact-URI kind, otel_trace); a producer MUST NOT assume a particular resolver.",
            "required": [
                "resolver_kind",
                "handle"
            ],
            "properties": {
                "resolver_kind": {
                    "type": "string",
                    "minLength": 1
                },
                "handle": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "bounds": {
            "type": "object",
            "description": "Event-time integer ticks; the window is [start_tick, end_tick) (SPEC §15.2/§15.3). Integers only — no float — and bit-identical across replays.",
            "required": [
                "start_tick",
                "end_tick"
            ],
            "properties": {
                "start_tick": {
                    "type": "integer",
                    "minimum": 0
                },
                "end_tick": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "reservoir_entry": {
            "type": "object",
            "description": "A salience-admitted entry (SPEC §3.7.1). Self-describing: carries the per-axis bands and the composite salience so a consumer can attribute it without the producer.",
            "required": [
                "template_id",
                "count",
                "frequency",
                "structural_surprise",
                "novelty",
                "salience"
            ],
            "properties": {
                "template_id": {
                    "type": "string",
                    "pattern": "^[a-z]+:.+$"
                },
                "count": {
                    "type": "integer",
                    "minimum": 0
                },
                "frequency": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "template": {
                    "type": "string",
                    "minLength": 1
                },
                "level": {
                    "type": "string"
                },
                "component": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The functional source that dominates this entry's occurrences (SPEC §3.8) — the same member as `stats.top_k[].component`, on the sibling object. Added in v0.8.0."
                },
                "structural_role": {
                    "type": "string"
                },
                "structural_surprise": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                },
                "novelty": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                },
                "salience": {
                    "type": "integer",
                    "minimum": 0
                },
                "within_window_ordinal": {
                    "type": "integer",
                    "minimum": 0
                },
                "cube_coord": {
                    "description": "LOCATION-only reservoir->cell cross (SPEC §16.6): the cube cell this salient entry occupies. Read-only, one-way (cube geometry -> item location), carries no salience. Present only when a cube block is emitted.",
                    "$ref": "#/$defs/cube_coord"
                }
            },
            "additionalProperties": false
        },
        "cube": {
            "type": "object",
            "description": "A closed cube over a small fixed set of low-card categorical axes (SPEC §16). Additive and experimental.",
            "required": [
                "axes",
                "cells",
                "cell_count",
                "raw_cell_count"
            ],
            "properties": {
                "axes": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Ordered axis descriptors. Frozen per (canonicalization_version, retention_profile); never adapted per window (SPEC §16.2).",
                    "items": {
                        "$ref": "#/$defs/cube_axis"
                    }
                },
                "cells": {
                    "type": "array",
                    "description": "The closed cells (the condensed representation). MUST serialise in canonical coord-sorted order for replay bit-identity (SPEC §16.4/§16.9).",
                    "items": {
                        "$ref": "#/$defs/cube_cell"
                    }
                },
                "cell_count": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Number of closed cells emitted."
                },
                "raw_cell_count": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Raw (pre-closure) populated-cell count. Collapse rate = cell_count / raw_cell_count."
                },
                "cell_budget": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "The producer's static closed-cell budget (SPEC \u00a716.10). Optional. It dominates every other term of the size formula (SPEC \u00a711.4), so an undeclared budget leaves a consumer unable to price the block. Added in v0.9.0."
                },
                "floor_saturation": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Optional WHERE-floor health metric: fraction of emerging borders that hit the floor without descending (SPEC §16.3). Health signal, not a gate."
                }
            },
            "additionalProperties": false
        },
        "cube_axis": {
            "type": "object",
            "description": "A cube axis descriptor (SPEC §16.2). kind=categorical is a flat low-card category; kind=chain is a single-parent roll-up hierarchy (SPEC §16.3), which additionally carries its ordered chain levels (coarsest first) and frozen floor_depth.",
            "required": [
                "name",
                "kind"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "kind": {
                    "type": "string",
                    "enum": [
                        "categorical",
                        "chain"
                    ]
                },
                "chain": {
                    "type": "array",
                    "minItems": 1,
                    "description": "kind=chain only: the ordered roll-up levels, coarsest first, down to (and including) the floor. The WHICH-leaf below the floor is NOT cubed (SPEC §16.3).",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "floor_depth": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "kind=chain only: the schema-frozen retained depth (<= len(chain)). A future runtime roll-up shrinks this with no schema change (SPEC §16.3)."
                },
                "band_floor": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Ordinal-axis collapse stamp (SPEC §16.2/§16.10): the applied interval-banding floor f — values [0..f-1] were merged into their top representative f-1. OMITTED when no banding was applied. Makes a collapsed cube self-describing, so a truncated granularity is never mistakable for a full one. Added in v0.8.0."
                }
            },
            "additionalProperties": false,
            "if": {
                "properties": {
                    "kind": {
                        "const": "chain"
                    }
                }
            },
            "then": {
                "required": [
                    "chain",
                    "floor_depth"
                ]
            }
        },
        "cube_cell": {
            "type": "object",
            "description": "A closed cube cell (SPEC §16.4): a coordinate and its COUNT measure.",
            "required": [
                "coord",
                "count"
            ],
            "properties": {
                "coord": {
                    "$ref": "#/$defs/cube_coord"
                },
                "count": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "cube_coord": {
            "type": "object",
            "description": "A cube cell coordinate, generic over axes (SPEC §16.4). Each key is a cube axis NAME; an ABSENT axis means aggregated (*). A categorical axis value is a string; a chain axis value is an ordered prefix-path array (array[i] = value at chain level i). Open over axis names so a future axis validates with no schema change; every value MUST be a string or an array of strings. coord {} is the fully-aggregated cell (window total).",
            "additionalProperties": {
                "oneOf": [
                    {
                        "type": "string",
                        "minLength": 1
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                ]
            }
        },
        "param_histogram": {
            "type": "object",
